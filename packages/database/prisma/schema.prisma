generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(uuid()) email String @unique name String? status String @default("active") devices Device[] sessions Session[] auditLogs AuditLog[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Device { id String @id @default(uuid()) userId String name String publicKey String? status String @default("pending") user User @relation(fields: [userId], references: [id], onDelete: Cascade) sessions Session[] healthChecks HealthCheck[] metrics Metric[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Session { id String @id @default(uuid()) userId String deviceId String? expiresAt DateTime revokedAt DateTime? user User @relation(fields: [userId], references: [id], onDelete: Cascade) device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull) createdAt DateTime @default(now()) }
model Configuration { id String @id @default(uuid()) key String @unique value Json environment String version Int @default(1) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Provider { id String @id @default(uuid()) type String name String slug String @unique status String @default("disabled") capabilities Json @default("{}") healthChecks HealthCheck[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model HealthCheck { id String @id @default(uuid()) providerId String? deviceId String? status String latencyMs Int? details Json @default("{}") checkedAt DateTime @default(now()) provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull) device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull) }
model Metric { id String @id @default(uuid()) name String value Float labels Json @default("{}") deviceId String? observedAt DateTime @default(now()) device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull) }
model AuditLog { id String @id @default(uuid()) actorUserId String? action String resource String metadata Json @default("{}") ipAddress String? createdAt DateTime @default(now()) actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull) }
model SystemSetting { id String @id @default(uuid()) key String @unique value Json description String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
