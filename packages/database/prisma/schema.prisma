generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  active
  suspended
  deleted
}
enum TokenType {
  refresh
  password_reset
  email_verification
}
enum MembershipStatus {
  invited
  active
  suspended
  removed
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.Citext
  name String?
  passwordHash String
  status UserStatus @default(pending)
  roles String[] @default([])
  permissions String[] @default([])
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  auditLogs AuditLog[] @relation("ActorAuditLogs")
  subscriptions Subscription[]
  payments PaymentTransaction[]
  devices Device[]
  entitlements Entitlement[]
  @@index([status, createdAt])
  @@index([deletedAt])
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  ownerUserId String? @db.Uuid
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  projects Project[]
  workspaces Workspace[]
  roles Role[]
  @@index([deletedAt])
}
model Project {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String
  slug String
  description String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaces Workspace[]
  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
}
model Workspace {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId String? @db.Uuid
  name String
  slug String
  environment String @default("production")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@unique([organizationId, slug])
  @@index([organizationId, projectId, deletedAt])
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  organizationId String @db.Uuid
  roleId String @db.Uuid
  status MembershipStatus @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([userId, organizationId])
  @@index([organizationId, status])
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  name String
  slug String
  system Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]
  @@unique([organizationId, slug])
}
model Permission {
  id String @id @default(uuid()) @db.Uuid
  action String @unique
  description String
  roles RolePermission[]
}
model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  familyId String @db.Uuid
  refreshTokenHash String @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens Token[]
  @@index([userId, revokedAt, expiresAt])
}
model Token {
  id String @id @default(uuid()) @db.Uuid
  sessionId String? @db.Uuid
  userId String @db.Uuid
  type TokenType
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([userId, type, expiresAt])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  action String
  resource String
  resourceId String?
  metadata Json @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())
  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([resource, resourceId])
  @@index([actorUserId, createdAt])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  type String
  aggregateId String
  payload Json
  occurredAt DateTime @default(now())
  processedAt DateTime?
  @@index([processedAt, occurredAt])
}
model CacheEntry {
  key String @id
  value Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

enum NetworkNodeStatus {
  active
  degraded
  offline
  unknown
}

model NetworkMeasurement {
  id String @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())
  probeType String
  latency Float?
  success Boolean
  error String?
  metadata Json @default("{}")
  @@index([probeType, timestamp])
  @@index([success, timestamp])
}

model NetworkNode {
  id String @id @default(uuid()) @db.Uuid
  name String
  location String?
  endpoint String
  status NetworkNodeStatus @default(unknown)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}

model NetworkHealthScore {
  id String @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())
  score Float
  factors Json @default("{}")
  @@index([timestamp])
}

enum IncidentSeverity {
  info
  warning
  critical
}

enum IncidentStatus {
  open
  acknowledged
  resolved
}

enum NotificationType {
  incident_opened
  incident_updated
  incident_resolved
  action_required
}

model Incident {
  id String @id @default(uuid()) @db.Uuid
  fingerprint String @unique
  title String
  severity IncidentSeverity
  status IncidentStatus @default(open)
  source String
  classification String
  rootCause String
  affectedComponents Json
  evidence Json
  correlationReason String
  confidence Float
  occurrenceCount Int @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt DateTime?
  updatedAt DateTime @updatedAt
  notifications Notification[]
  @@index([status, severity, lastSeenAt])
  @@index([source, lastSeenAt])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  type NotificationType
  severity IncidentSeverity
  title String
  message String
  actionable Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  @@index([readAt, createdAt])
  @@index([incidentId, createdAt])
}


model NetworkIntentRecord {
  id String @id @db.VarChar(128)
  version Int
  status String @db.VarChar(32)
  priority String @db.VarChar(16)
  spec Json
  createdAt DateTime
  updatedAt DateTime
  effectiveFrom DateTime?
  expiresAt DateTime?
  supersedes String? @db.VarChar(128)
  metadata Json @default("{}")
  provenance String? @db.VarChar(512)
  confidence Float?
  autonomy String? @db.VarChar(40)
  ownerPrincipalId String @db.VarChar(255)
  organizationId String? @db.VarChar(128)
  ownerScopeKey String @db.VarChar(384)
  idempotencyKey String? @db.VarChar(128)
  idempotencyFingerprint String? @db.VarChar(64)
  @@index([ownerPrincipalId, status, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@index([ownerScopeKey, status, updatedAt])
  @@unique([ownerScopeKey, idempotencyKey])
}

model IntentConflictRecord {
  id          String   @id @db.VarChar(256)
  intentAId   String   @db.VarChar(128)
  intentBId   String   @db.VarChar(128)
  reason      String
  resolution  String   @db.VarChar(32)
  ownerScopeKey String @db.VarChar(384)
  recordedAt  DateTime
  @@index([ownerScopeKey, recordedAt])
}
model RateLimitBucket {
  key String @id
  count Int
  resetAt DateTime
  @@index([resetAt])
}

enum SubscriptionStatus {
  REGISTERED
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DeviceStatus {
  ENROLLED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model SubscriptionPlan {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  priceUsd    Int      // cents
  currency    String   @default("usd")
  durationDays Int     // plan duration in days
  maxDevices  Int      @default(1)
  features    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]
  @@index([isActive, slug])
}

model Subscription {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  planId            String           @db.Uuid
  status            SubscriptionStatus @default(REGISTERED)
  startedAt         DateTime?
  expiresAt         DateTime?
  renewedAt         DateTime?
  canceledAt        DateTime?
  autoRenew         Boolean          @default(false)
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  payments          PaymentTransaction[]
  entitlements      Entitlement[]
  devices           Device[]
  @@index([userId, status])
  @@index([planId, status])
}

model PaymentTransaction {
  id             String      @id @default(uuid()) @db.Uuid
  subscriptionId String      @db.Uuid
  userId         String      @db.Uuid
  amountUsd      Int         // cents
  currency       String      @default("usd")
  status         PaymentStatus @default(PENDING)
  provider       String      // e.g. 'stripe', 'test'
  providerRef    String?     @unique
  paidAt         DateTime?
  failureReason  String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([subscriptionId, status])
  @@index([userId, status])
  @@index([providerRef])
}

model Device {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  subscriptionId String?     @db.Uuid
  deviceId       String      @unique // client-generated device identifier
  label          String?
  platform       String?     // ios, android, linux, macos, windows
  status         DeviceStatus @default(ENROLLED)
  authorizedAt   DateTime?
  revokedAt      DateTime?
  lastConnectedAt DateTime?
  lastDisconnectedAt DateTime?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  connectionState ConnectionState[]
  @@index([userId, status])
  @@index([subscriptionId])
}

model ConnectionState {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  connected Boolean  @default(false)
  quality   String?  // e.g. 'good', 'degraded', 'poor'
  latencyMs Int?
  reason    String?
  recordedAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@index([deviceId, recordedAt])
}

model Entitlement {
  id            String        @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  userId        String        @db.Uuid
  feature       String        // e.g. 'connect', 'tunnel', 'dns', 'multi-device'
  status        EntitlementStatus @default(ACTIVE)
  startedAt     DateTime      @default(now())
  expiresAt     DateTime?
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subscription  Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, feature, status])
  @@index([subscriptionId, status])
}
