{
  "name": "@irp/desktop",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "types": "dist/shared/ipc-contracts.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "pnpm build && electron . --demo healthy",
    "package:linux": "pnpm build && node scripts/package-linux.mjs"
  },
  "dependencies": {
    "@irp/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
