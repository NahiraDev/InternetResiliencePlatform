{
  "schemaVersion": 1,
  "name": "irp-production-certification",
  "requiredEvidence": [
    "repository-gates",
    "security-audit",
    "artifact-integrity",
    "control-plane-runtime",
    "gateway-runtime",
    "regional-evidence",
    "upgrade-rollback",
    "backup-restore",
    "chaos-soak",
    "accessibility",
    "localization",
    "platform-runtime",
    "ios-device-smoke",
    "android-device-smoke",
    "release-engineering"
  ],
  "requiredFields": [
    "id",
    "status",
    "observedAt",
    "source",
    "commitSha",
    "artifactSha256"
  ],
  "terminalStatuses": ["pass", "fail", "pending"],
  "certificationStatus": "pass requires every required evidence item to have status=pass and a valid bundle signature"
}
