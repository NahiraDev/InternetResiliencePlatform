{
  "phase": 71,
  "name": "Cross-Platform Distribution & GitHub Releases",
  "releaseTagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "assets": [
    { "platform": "android", "filename": "IRP-Android-debug-{tag}.apk", "kind": "apk" },
    { "platform": "linux", "filename": "IRP-Linux-{tag}.tar.gz", "kind": "tarball" },
    { "platform": "macos", "filename": "IRP-macOS-{tag}.tar.gz", "kind": "tarball" },
    { "platform": "windows", "filename": "IRP-Windows-{tag}.zip", "kind": "zip" },
    { "platform": "ios", "filename": "IRP-iOS-source-{tag}.zip", "kind": "source" }
  ],
  "forbidden": ["*.ipa"],
  "checksums": "SHA256SUMS.txt"
}
