# /etc/irp/irp.env — daemon configuration (read by irp-daemon.service)

# safe (default): observe and decide, never change the host.
# simulation:     like safe, decisions marked as simulated.
# live:           may change routes/DNS. Requires BOTH lines below.
IRP_RUNTIME_MODE=safe
#IRP_ENABLE_LIVE_ROUTE_MUTATION=true

# Run the periodic decision cycle every 30 s (otherwise cycles run only on request).
IRP_RUNTIME_ENABLED=1

# Optional: destination the daemon verifies reachability to.
#IRP_DESTINATION_URL=https://example.com
