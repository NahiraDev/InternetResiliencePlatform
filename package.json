{
  "name": "internet-resilience-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "coverage": "turbo run test -- --coverage",
    "validate": "node scripts/validate-repository.mjs",
    "phase19-demo": "node examples/phase-19/phase19-demo.mjs",
    "clean": "node scripts/clean.mjs",
    "phase23:e2e": "pnpm --filter @irp/resilience-runtime test -- tests/phase23.test.ts",
    "docker:smoke": "bash scripts/docker-smoke.sh"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "@types/pg": "8.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "type": "module"
}
