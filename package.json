{
  "name": "internet-resilience-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "coverage": "turbo run test -- --coverage",
    "validate": "node scripts/validate-repository.mjs",
    "phase19-demo": "node examples/phase-19/phase19-demo.mjs",
    "clean": "node scripts/clean.mjs",
    "phase23:e2e": "pnpm --filter @irp/resilience-runtime test -- tests/phase23.test.ts"
  },

  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "turbo": "^2.3.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "prisma": "7.9.1",
      "@prisma/client": "6.14.0"
    }
  }
}
