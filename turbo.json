{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tsconfig.base.json"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "APP_NAME",
        "APP_VERSION",
        "API_HOST",
        "API_PORT",
        "LOG_LEVEL",
        "TELEMETRY_ENABLED",
        "DATABASE_URL",
        "JWT_SECRET",
        "REMOTE_CLIENT_CREDENTIAL_KEY",
        "REMOTE_CLIENT_REFRESH_KEY",
        "IRP_EMAIL_WEBHOOK_URL",
        "IRP_EMAIL_WEBHOOK_TOKEN",
        "IRP_PUBLIC_BASE_URL",
        "VERCEL",
        "VERCEL_ENV"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../eslint.config.js"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "../../vitest.config.ts"],
      "env": ["IRP_TEST_DATABASE_URL"],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tsconfig.base.json"],
      "outputs": []
    }
  }
}
